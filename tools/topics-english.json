{
  "schema": "openstudy.topics/2",
  "subject": "english",
  "title": "高中英语",
  "groups": {
    "A": {
      "label": "A 条件 → 方程 → 边界",
      "steps": [
        "把题给条件逐条写成等式或不等式（含取值范围）",
        "把目标量也写成含未知量的式子",
        "联立消元，得到只含一个未知量的方程",
        "解出后回代，逐个核对定义域与题给范围"
      ],
      "checks": [
        "定义域是否漏（分母、根号、对数真数）",
        "等号能否取到（端点是否含）",
        "是否多解需要舍去"
      ]
    },
    "B": {
      "label": "B 证据 → 判断",
      "steps": [
        "圈出题干中给数据与要求的那句话",
        "分辨哪个数据是干扰项",
        "按定义或公式直接算，不凭印象",
        "把结果代回情境解释一遍"
      ],
      "checks": [
        "数据有没有换单位",
        "是不是把百分数当成了数值",
        "结论是否回答了被问的那一量"
      ]
    },
    "C": {
      "label": "C 触发 → 精确复现",
      "steps": [
        "认出这一步考的是哪条定义或公式",
        "按标准形式写出，不省步",
        "对答案做一次快速验算"
      ],
      "checks": [
        "符号（正负、共轭、补集）",
        "定义域与端点",
        "答案形式是否符合要求（最简、区间、集合）"
      ]
    },
    "D": {
      "label": "D 骨架 → 成文",
      "steps": [
        "写清要证/要求的是什么",
        "给出中间结论并说明依据（哪条定理、哪个条件）",
        "把每步连成因果链，结尾回到结论"
      ],
      "checks": [
        "每一步是否都有依据",
        "是否有该讨论的情形漏掉",
        "结论句是否完整"
      ]
    }
  },
