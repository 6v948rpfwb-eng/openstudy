  "schema": "openstudy.topics/2",
  "subject": "technology",
  "title": "高中技术（信息技术 + 通用技术）",
  "groups": {
    "A": {
      "label": "A 条件→方程→边界",
      "steps": [
        "读条件，把已知量列成表",
        "写出关系式（公式或规律）",
        "代入求解，注意单位和有效数字",
        "回代检验：是否符合题设范围"
      ],
      "checks": [
        "条件抄全了吗",
        "单位换了吗",
        "边界（范围/取值）查了吗"
      ]
    },
    "B": {
      "label": "B 证据→判断",
      "steps": [
        "读题干，圈出判断的关键词",
        "在脑里找出对应概念或原理",
        "逐项比对选项与原理",
        "选出后回读题干，确认没扩大或缩小范围"
      ],
      "checks": [
        "有没有凭印象选",
        "选项有没有偷换主体或条件",
        "有没有把\"一定\"当成\"可能\""
      ]
    },
    "C": {
      "label": "C 触发→精确复现",
      "steps": [
        "从题干里的触发词（名称/符号/场景）认出考点",
        "在心里默写对应名称、符号或规则",
        "写出来后逐字核对",
        "不确定就标注，别猜"
      ],
      "checks": [
        "符号和下标写全了吗",
        "名称有没有写混（相似概念）",
        "关键词有没有漏"
      ]
    },
    "D": {
      "label": "D 骨架→成文",
      "steps": [
        "先写骨架（要点序号）",
        "每点补一句支撑",
        "检查要点是否覆盖题干要求"
      ],
      "checks": [
        "要点齐了吗",
        "有没有答非所问"
      ]
    }
  },
