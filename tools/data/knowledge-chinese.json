  "Ky-01": {
   "name": "论述类文本结构",
   "block": "modern",
   "topic": "Y-01",
   "core": [
    "常见结构：提出观点—分析论证—得出结论",
    "论点与论据要能对应",
    "关注关联词：然而、因此、更重要的是"
   ],
   "formulas": [
    "论点+论据"
   ],
   "confusions": [
    "把论据当论点",
    "选项张冠李戴"
   ],
   "prereq": []
  },
  "Ky-02": {
   "name": "筛选与整合信息",
   "block": "modern",
   "topic": "Y-02",
   "core": [
    "按题干限定范围回原文找",
    "同义改写处最容易出错",
    "范围词决定对错：部分/全部、已经/将要"
   ],
   "formulas": [
    "范围词清单"
   ],
   "confusions": [
