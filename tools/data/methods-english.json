{
 "schema": "openstudy.methods/1",
 "subject": "english",
 "title": "高中英语 · 方法论（按题型）",
 "methods": [
  {
   "id": "Me-01",
   "name": "语法填空",
   "group": "C",
   "cues": [
    "括号里给的词要变形",
    "没有提示词的空填冠词/介词/连词/代词"
   ],
   "steps": [
    "判词性",
    "判形式（时态/单复数/比较级）",
    "判是否有提示词"
   ],
   "checks": [
    "词性对但形式错",
    "介词固定搭配"
   ],
   "topics": [
    "Ke-04",
    "Ke-01"
   ]
  },
  {
   "id": "Me-02",
   "name": "完形填空",
   "group": "B",
   "cues": [
    "15 个空，先通读抓主线",
    "每个空看前后一句"
   ],
   "steps": [
    "通读全文抓主题",
    "逐空先填最有把握的",
    "回读校验逻辑"
   ],
   "checks": [
    "只凭搭配不看上下文",
    "忽略转折词"
   ],
   "topics": [
    "Ke-12"
   ]
  },
  {
   "id": "Me-03",
   "name": "阅读·细节题",
   "group": "B",
   "cues": [
    "题干有具体人名、数字、时间"
   ],
   "steps": [
    "圈题干关键词",
    "回原文定位",
    "比对选项与原文差异"
   ],
   "checks": [
    "选项偷换范围",
    "同义替换没认出来"
   ],
   "topics": [
    "Ke-13"
   ]
  },
  {
   "id": "Me-04",
   "name": "阅读·主旨题",
   "group": "B",
   "cues": [
    "问 main idea / best title"
   ],
   "steps": [
    "看首段与各段首句",
    "归纳共同主题",
    "排除过窄或过宽选项"
   ],
   "checks": [
    "选成细节",
    "标题太大"
   ],
   "topics": [
    "Ke-13"
   ]
  },
  {
   "id": "Me-05",
   "name": "七选五",
   "group": "B",
   "cues": [
    "一段挖 5 个空，选项 7 个"
   ],
   "steps": [
    "先做有代词或逻辑词的",
    "再看段首段尾位置",
    "最后用排除法"
   ],
   "checks": [
    "忽略代词指代",
    "两个空争同一选项"
   ],
   "topics": [
    "Ke-12"
   ]
  },
  {
   "id": "Me-06",
   "name": "应用文写作",
   "group": "D",
   "cues": [
    "给情境写 80 词左右书信/通知"
   ],
   "steps": [
    "列要点",
    "套格式",
    "检查时态与拼写"
   ],
   "checks": [
    "漏要点",
    "格式缺称呼落款"
   ],
   "topics": [
    "Ke-14"
   ]
  },
  {
   "id": "Me-07",
   "name": "读后续写",
   "group": "D",
   "cues": [
    "给一段故事开头，续写两段"
   ],
   "steps": [
    "抓人物与冲突",
    "每段一个动作推进",
    "结尾呼应主题"
   ],
   "checks": [
    "情节跑偏",
    "两段没有推进"
   ],
   "topics": [
    "Ke-15"
   ]
  },
  {
   "id": "Me-08",
   "name": "听力",
   "group": "B",
   "cues": [
    "听对话选答案"
   ],
   "steps": [
    "先看题干预测内容",
    "抓数字、地点、态度词",
    "第二遍核对"
   ],
   "checks": [
    "被干扰项带走",
    "漏听转折"
   ],
   "topics": [
    "Ke-12"
   ]
  }
 ]
}