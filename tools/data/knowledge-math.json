 "nodes": {
  "Km-01": {
   "name": "导数的几何意义",
   "block": "func",
   "topic": "M-01",
   "core": [
    "f'(x0) 是曲线在 x=x0 处切线的斜率",
    "切线方程用点斜式，切点必须落在曲线上",
    "「过某点的切线」与「在某点的切线」不是一回事"
   ],
   "formulas": [
    "k = f'(x0)",
    "y − f(x0) = f'(x0)(x − x0)"
   ],
   "confusions": [
    "把「过点 A 的切线」当成「在点 A 的切线」：前者要设切点再解",
    "切点纵坐标写成了切线上的 y"
   ],
   "prereq": []
  },
  "Km-02": {
   "name": "单调性与极值",
   "block": "func",
   "topic": "M-02",
   "core": [
    "f'(x) > 0 的区间单调递增，< 0 单调递减",
    "极值点是导数为 0 且左右变号的点",
    "含参数时按判别式或根的位置分类讨论"
   ],
   "formulas": [
    "f'(x) > 0 ⇒ 单调增",
    "f'(x0) = 0 只是极值的必要条件"
   ],
   "confusions": [
    "f'(x0)=0 就断言是极值点：x³ 在 0 处不是",
    "讨论不完整，漏掉导函数无实根的情形"
   ],
   "prereq": [
    "Km-01"
   ]
  },
  "Km-03": {
   "name": "零点与隐零点",
   "block": "func",
   "topic": "M-03",
   "core": [
    "零点个数 = 图象与 x 轴交点个数",
    "隐零点是存在但解不出的零点，用 f(x0)=0 代换",
    "极值点偏移用对称构造比较两个零点"
   ],
   "formulas": [
    "f(a)f(b) < 0 ⇒ (a,b) 内有零点"
   ],
   "confusions": [
    "只证存在不证唯一",
    "隐零点代换时把 f(x0)=0 用错方向"
   ],
   "prereq": [
    "Km-02"
   ]
  },
  "Km-04": {
   "name": "不等式与放缩",
   "block": "func",
   "topic": "M-04",
   "core": [
    "恒成立问题转成最值问题",
    "常用放缩：ln x ≤ x − 1、e^x ≥ x + 1",
    "双变量先固定一个，转成单变量"
   ],
   "formulas": [
    "ln x ≤ x − 1（x > 0）",
    "e^x ≥ x + 1"
   ],
   "confusions": [
    "放缩后方向反了",
    "把「存在」当成「任意」"
   ],
   "prereq": [
    "Km-03"
   ]
  },
  "Km-05": {
   "name": "函数性质：奇偶、周期、对称",
   "block": "func",
   "topic": "M-05",
   "core": [
    "f(−x)=−f(x) 奇函数，f(−x)=f(x) 偶函数",
    "f(x+T)=f(x) 则 T 是周期",
    "f(a+x)=f(a−x) 表示关于 x=a 对称"
   ],
   "formulas": [
    "f(x+2)=−f(x) ⇒ 周期 4"
   ],
   "confusions": [
    "对称轴与周期混用",
    "判断奇偶先看定义域是否关于原点对称"
   ],
   "prereq": [
    "Km-04"
   ]
  },
  "Km-06": {
   "name": "椭圆",
   "block": "conic",
   "topic": "M-06",
   "core": [
    "到两焦点距离之和为 2a（2a > 2c）",
    "a² = b² + c²",
    "离心率 e = c/a，越接近 1 越扁"
   ],
   "formulas": [
    "|PF1| + |PF2| = 2a",
    "e = c/a"
   ],
   "confusions": [
    "把 a² = b² − c² 用到椭圆上（那是双曲线）",
    "忘记 2a > 2c 的限制"
   ],
   "prereq": []
  },
  "Km-07": {
   "name": "双曲线",
   "block": "conic",
   "topic": "M-07",
   "core": [
    "到两焦点距离之差的绝对值为 2a",
    "c² = a² + b²",
    "渐近线 y = ±(b/a)x（焦点在 x 轴时）"
   ],
   "formulas": [
    "||PF1| − |PF2|| = 2a",
    "c² = a² + b²"
   ],
   "confusions": [
    "把差的绝对值漏掉",
    "焦点在 y 轴时渐近线要重新推"
   ],
   "prereq": [
    "Km-06"
   ]
  },
  "Km-08": {
   "name": "抛物线",
   "block": "conic",
   "topic": "M-08",
   "core": [
    "到焦点与到准线距离相等",
    "y² = 2px 的焦点 (p/2,0)，准线 x = −p/2",
    "焦点弦长与通径 2p"
   ],
   "formulas": [
    "y² = 2px",
    "|AB| = x1 + x2 + p"
   ],
   "confusions": [
    "p 的符号与开口方向混淆",
    "焦点弦长公式记错"
   ],
   "prereq": [
    "Km-07"
   ]
  },
  "Km-09": {
   "name": "直线与圆锥曲线",
   "block": "conic",
   "topic": "M-09",
   "core": [
    "设直线时要讨论斜率不存在的情形",
    "用韦达定理把弦长、面积化成和与积",
    "定点定值：先算含参表达式，再看参数怎么消失"
   ],
   "formulas": [
    "弦长 = √(1+k²)|x1−x2|",
    "x1+x2 = −B/A，x1x2 = C/A"
   ],
   "confusions": [
    "忘记判别式 Δ > 0",
    "面积公式漏 1/2"
   ],
   "prereq": [
    "Km-08"
   ]
  },
  "Km-10": {
   "name": "空间几何体",
   "block": "solid",
   "topic": "M-10",
   "core": [
    "体积：柱 Sh、锥 Sh/3、球 4πR³/3",
    "表面积要算全部面",
    "三视图长对正、高平齐、宽相等"
   ],
   "formulas": [
    "V锥 = Sh/3",
    "V球 = 4πR³/3",
    "S球 = 4πR²"
   ],
   "confusions": [
    "锥体忘除 3",
    "三视图复原时把虚线当实线"
   ],
   "prereq": []
  },
  "Km-11": {
   "name": "点线面关系",
   "block": "solid",
   "topic": "M-11",
   "core": [
    "线面平行判定：平面外一条线与平面内一条线平行",
    "线面垂直判定：与平面内两条相交直线都垂直",
    "二面角要作出平面角再算"
   ],
   "formulas": [
    "线面角 sinθ = |cos<l,n>|"
   ],
   "confusions": [
    "用一条线平行去证面面平行（不够）",
    "二面角取成钝角却没判断"
   ],
   "prereq": [
    "Km-10"
   ]
  },
  "Km-12": {
   "name": "空间向量",
   "block": "solid",
   "topic": "M-12",
   "core": [
    "建系前先找两两垂直的三条线",
    "法向量由两个方向向量叉乘或解方程组",
    "线面角用 sin，二面角用 cos"
   ],
   "formulas": [
    "n = a × b",
    "sinθ = |a·n|/(|a||n|)"
   ],
   "confusions": [
    "线面角误用 cos",
    "法向量方向没检验"
   ],
   "prereq": [
    "Km-11"
   ]
  },
  "Km-13": {
   "name": "概率与条件概率",
   "block": "prob",
   "topic": "M-13",
   "core": [
    "互斥事件相加，独立事件相乘",
    "条件概率 P(B|A) = P(AB)/P(A)",
    "古典概型要数清样本空间"
   ],
   "formulas": [
    "P(B|A) = P(AB)/P(A)",
    "独立时 P(AB) = P(A)P(B)"
   ],
   "confusions": [
    "把互斥当成独立",
    "条件概率分母写成 P(B)"
   ],
   "prereq": []
  },
  "Km-14": {
   "name": "分布列与期望",
   "block": "prob",
   "topic": "M-14",
   "core": [
    "先列全部取值，逐个算概率，最后验证和为 1",
    "E(X) = Σ x·p",
    "二项分布 E = np，D = np(1−p)"
   ],
   "formulas": [
    "E(X) = Σ x_i p_i",
    "D(X) = E(X²) − [E(X)]²"
   ],
   "confusions": [
    "概率和不是 1",
    "超几何当二项算"
   ],
   "prereq": [
    "Km-13"
   ]
  },
  "Km-15": {
   "name": "统计案例",
   "block": "prob",
   "topic": "M-15",
   "core": [
    "线性回归过样本中心点 (x̄,ȳ)",
    "卡方越大越有把握有关",
    "百分位数按累计频率定位"
   ],
   "formulas": [
    "b̂ = Σ(xi−x̄)(yi−ȳ)/Σ(xi−x̄)²"
   ],
   "confusions": [
    "回归直线不经过样本中心",
    "把卡方结论说成「一定有关」"
   ],
   "prereq": [
    "Km-14"
   ]
  },
  "Km-16": {
   "name": "统计应用",
   "block": "prob",
   "topic": "M-16",
   "core": [
    "先把文字情境翻成变量与分布",
    "注意样本量与题目限制",
    "结论要回到情境说一句"
   ],
   "formulas": [],
   "confusions": [
    "直接套公式不看情境"
   ],
   "prereq": [
    "Km-15"
   ]
  },
  "Km-17": {
   "name": "三角恒等变换",
   "block": "trig",
   "topic": "M-17",
   "core": [
    "和差角、二倍角是主干，诱导公式把角拉回锐角",
    "化简目标：一个角、一个函数名",
    "齐次式用 tan 表示"
   ],
   "formulas": [
    "sin(α±β) = sinαcosβ ± cosαsinβ",
    "cos2α = 1 − 2sin²α"
   ],
   "confusions": [
    "cos2α 选错形式导致符号错",
    "把 sin²α 当成 sin(α²)"
   ],
   "prereq": []
  },
  "Km-18": {
   "name": "三角函数图象与性质",
   "block": "trig",
   "topic": "M-18",
   "core": [
    "y = A sin(ωx+φ)：振幅 A、周期 2π/ω、初相 φ",
    "单调区间由整体相位代入",
    "平移要看 x 的系数，先提 ω"
   ],
   "formulas": [
    "T = 2π/ω"
   ],
   "confusions": [
    "左右平移时没提 ω",
    "对称轴与零点位置混"
   ],
   "prereq": [
    "Km-17"
   ]
  },
  "Km-19": {
   "name": "解三角形",
   "block": "trig",
   "topic": "M-19",
   "core": [
    "两角一边或两边一对角用正弦定理",
    "三边或两边夹角用余弦定理",
    "面积 S = ½ab sinC"
   ],
   "formulas": [
    "a/sinA = b/sinB = 2R",
    "c² = a² + b² − 2ab cosC",
    "S = ½ab sinC"
   ],
   "confusions": [
    "正弦定理解出两解时漏掉钝角解",
    "余弦定理符号写成 +2ab cosC"
   ],
   "prereq": [
    "Km-18"
   ]
  },
  "Km-20": {
   "name": "等差与等比",
   "block": "seq",
   "topic": "M-20",
   "core": [
    "等差：a_n = a1+(n−1)d，S_n = n(a1+an)/2",
    "等比：a_n = a1 q^(n−1)，S_n = a1(1−q^n)/(1−q)",
    "判断类型看相邻两项的差或比是否为常数"
   ],
   "formulas": [
    "S_n = n a1 + n(n−1)d/2"
   ],
   "confusions": [
    "等比求和忘讨论 q = 1",
    "把差为常数当成比为常数"
   ],
   "prereq": []
  },
  "Km-21": {
   "name": "递推数列",
   "block": "seq",
   "topic": "M-21",
   "core": [
    "a_{n+1} − a_n = f(n) 用累加",
    "a_{n+1}/a_n = f(n) 用累乘",
    "a_{n+1} = p a_n + q 用构造等比"
   ],
   "formulas": [
    "a_n = a1 + Σ f(k)"
   ],
   "confusions": [
    "累加下限写错少加首项",
    "构造时没检验系数为 0"
   ],
   "prereq": [
    "Km-20"
   ]
  },
  "Km-22": {
   "name": "数列求和",
   "block": "seq",
   "topic": "M-22",
   "core": [
    "等差×等比用错位相减",
    "分式型用裂项相消",
    "奇偶项不同用分组求和"
   ],
   "formulas": [
    "1/[n(n+1)] = 1/n − 1/(n+1)"
   ],
   "confusions": [
    "错位相减后项数少一项",
    "裂项后没检验首尾是否抵消干净"
   ],
   "prereq": [
    "Km-21"
   ]
  },
  "Km-23": {
   "name": "数列不等式",
   "block": "seq",
   "topic": "M-23",
   "core": [
    "先证单调，再夹逼",
    "放缩要保留可求和的形状"
   ],
   "formulas": [
    "1/n² < 1/[n(n−1)]"
   ],
   "confusions": [
    "放缩过头，界不成立"
   ],
   "prereq": [
    "Km-22"
   ]
  },
  "Km-24": {
   "name": "集合",
   "block": "basic",
   "topic": "M-24",
   "core": [
    "交集取公共，并集取全部，补集取全集剩下的",
    "含参数先看空集",
    "注意元素互异性"
   ],
   "formulas": [
    "A∩B、A∪B、∁UA"
   ],
   "confusions": [
    "空集是任何集合的子集，讨论时漏掉",
    "区间端点开闭弄反"
   ],
   "prereq": []
  },
  "Km-25": {
   "name": "复数",
   "block": "basic",
   "topic": "M-25",
   "core": [
    "除法乘共轭分母实数化",
    "|z| 是模，z·z̄ = |z|²",
    "纯虚数要求实部为 0 且虚部不为 0"
   ],
   "formulas": [
    "(a+bi)(a−bi) = a²+b²",
    "i² = −1"
   ],
   "confusions": [
    "虚部写成 bi（虚部是 b）",
    "纯虚数忘检查虚部非 0"
   ],
   "prereq": [
    "Km-24"
   ]
  },
  "Km-26": {
   "name": "平面向量",
   "block": "basic",
   "topic": "M-26",
   "core": [
    "坐标运算逐分量做",
    "数量积 a·b = |a||b|cosθ",
    "平行看 x1y2 − x2y1 = 0，垂直看数量积为 0"
   ],
   "formulas": [
    "a·b = x1x2 + y1y2",
    "|a| = √(x²+y²)"
   ],
   "confusions": [
    "平行与垂直条件互串",
    "投影是数量不是向量"
   ],
   "prereq": [
    "Km-25"
   ]
  },
  "Km-27": {
   "name": "不等式",
   "block": "basic",
   "topic": "M-27",
   "core": [
    "一元二次不等式看开口与根",
    "基本不等式要验证一正二定三相等",
    "线性规划看目标函数截距"
   ],
   "formulas": [
    "a+b ≥ 2√(ab)（a,b>0）"
   ],
   "confusions": [
    "没验证等号能否取到",
    "可行域边界虚实搞错"
   ],
   "prereq": [
    "Km-26"
   ]
  },
  "Km-28": {
   "name": "排列组合与二项式",
   "block": "basic",
   "topic": "M-28",
   "core": [
    "先分类再分步：分类加法、分步乘法",
    "相邻用捆绑，不相邻用插空",
    "二项式通项 T_{r+1} = C(n,r)a^{n−r}b^r"
   ],
   "formulas": [
    "T_{r+1} = C(n,r)a^{n−r}b^r"
   ],
   "confusions": [
    "重复计数（有序当无序）",
    "二项式系数与项系数混"
   ],
   "prereq": [
    "Km-27"
   ]
  }
 }
