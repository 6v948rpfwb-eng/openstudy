  "groups": {
    "A": {
      "label": "条件→方程→边界",
      "steps": [
        "圈条件词（恰好/足量/至少/缓慢/温度压强/保持…不变）",
        "只写式子或方程，不代数字",
        "解出后把答案代回原条件核对",
        "查边界：范围端点是否取到、单位与有效数字"
      ],
      "checks": [
        "单位换算（mL→L、kJ→J、mol→mol·L⁻¹）",
        "极端值代回（0、∞、等于物质量时）",
        "区间端点是否包含、是否舍去增根"
      ]
    },
    "B": {
      "label": "证据→判断",
      "steps": [
        "先读清题干问的是「正确」还是「不正确」并圈出",
        "把每个选项拆成一条独立事实，逐条编号",
        "逐条到材料/题干/教材找依据，指不出依据的一条不选",
        "剩下的两两比较，留依据最硬的那条"
      ],
      "checks": [
        "反向题（选不正确/不合理）最易漏",
        "绝对化表述（所有/一定/均/只）先怀疑",
        "选项是否偷换了主体、条件或范围"
      ]
    },
    "C": {
      "label": "触发→精确复现",
      "steps": [
        "先认出触发点（看到「电子式/配平/方程式/性质/俗名」就切到本组）",
        "按固定格式写出来，不跳步",
        "写完反向核对一遍：念回题目要求",
        "逐项过格式细节（下标、电荷、条件、↑↓、反应条件）"
      ],
      "checks": [
        "配平与电荷守恒同时成立",
        "电子式孤对电子成对、不缺不多",
        "符号与文字（↑↓、Δ、催化剂、浓/稀）"
      ]
    },
    "D": {
      "label": "骨架→成文",
      "steps": [
        "先写三行骨架：要答什么 / 依据什么 / 结论是什么",
        "往骨架里填句块，一句一个要点",
        "按要点清单自查，缺的补上",
        "核字数与限时"
      ],
      "checks": [
        "要点数是否覆盖题干要求的个数",
        "原因类必须出现「因为…所以…」",
        "专业术语不得口语化替换"
      ]
    }
  },
